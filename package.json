{
  "publisher": "zkreations",
  "name": "blogger-syntax",
  "displayName": "Blogger Syntax",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@12.9.1",
  "description": "Support and autocomplete for Blogger syntax.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkreations/blogger-syntax.git"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "main": "./dist/extension.cjs",
  "icon": "images/logo.png",
  "browser": "./dist/web/extension.js",
  "engines": {
    "vscode": "^1.95.0"
  },
  "galleryBanner": {
    "color": "#0a0316",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:handlebars"
  ],
  "contributes": {
    "configuration": {
      "title": "Blogger Syntax",
      "properties": {
        "bloggerSyntax.autoTriggerInEmptyAttributes": {
          "type": "boolean",
          "default": true,
          "description": "Automatically trigger suggestions when moving the cursor inside empty description=\"\" or type=\"\" attributes."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.3",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
}
