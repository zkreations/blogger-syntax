{
  "Attribute tag": {
    "prefix": "b:attr",
    "body": [
      "<b:attr name=\"${1:name}\" value=\"${2:value}\"/>$0"
    ],
    "description": "Adds an attribute with its corresponding value to the parent node."
  },
  "Class tag": {
    "prefix": "b:class",
    "body": [
      "<b:class name=\"${1:className}\"/>$0"
    ],
    "description": "Adds or appends CSS classes to the parent node."
  },
  "Comment tag": {
    "prefix": "b:comment",
    "body": [
      "<b:comment>",
      "\t$0",
      "</b:comment>"
    ],
    "description": "Creates comments that may or may not be visible on the client side."
  },
  "Default markup tags": {
    "prefix": "b:defaultmarkups",
    "body": [
      "<b:defaultmarkups>",
      "\t<b:defaultmarkup type=\"${1:Blog}\">",
      "\t\t$0",
      "\t</b:defaultmarkup>",
      "</b:defaultmarkups>"
    ],
    "description": "Configures the default markup of the template."
  },
  "Default include tags": {
    "prefix": "b:defaultmarkup",
    "body": [
      "<b:defaultmarkup type=\"${1:Blog}\">",
      "\t$0",
      "</b:defaultmarkup>"
    ],
    "description": "Configures default template includes for a widget type."
  },
  "Expression tag": {
    "prefix": "b:eval",
    "body": [
      "<b:eval expr=\"${1:expression}\"/>$0"
    ],
    "description": "Evaluates a Blogger expression and explicitly outputs the result."
  },
  "Conditional tag": {
    "prefix": "b:if",
    "body": [
      "<b:if cond=\"${1:condition}\">",
      "\t$0",
      "</b:if>"
    ],
    "description": "Renders content if the specified condition evaluates to true."
  },
  "Else if tag": {
    "prefix": "b:elseif",
    "body": [
      "<b:elseif cond=\"${1:condition}\"/>$0"
    ],
    "description": "Additional conditional branch based on a previous b:if evaluation."
  },
  "Else tag": {
    "prefix": "b:else",
    "body": [
      "<b:else/>$0"
    ],
    "description": "Otherwise case of the previous conditional evaluation."
  },
  "Includable tag": {
    "prefix": "b:includable",
    "body": [
      "<b:includable id=\"${1:main}\" var=\"${2:this}\">",
      "\t$0",
      "</b:includable>"
    ],
    "description": "Defines a reusable template section or macro."
  },
  "Include tag": {
    "prefix": "b:include",
    "body": [
      "<b:include name=\"${1:main}\" data=\"${2:data}\"/>$0"
    ],
    "description": "Executes and renders a b:includable section."
  },
  "Loop tag": {
    "prefix": "b:loop",
    "body": [
      "<b:loop values=\"${1:data:posts}\" var=\"${2:post}\">",
      "\t$0",
      "</b:loop>"
    ],
    "description": "Allows iterating over elements of an Array data type."
  },
  "Message tag": {
    "prefix": "b:message",
    "body": [
      "<b:message name=\"${1:messages.readMore}\">",
      "\t<b:param name=\"${2:name}\" value=\"${3:value}\"/>",
      "</b:message>$0"
    ],
    "description": "Accesses and formats a localized UI message from Blogger."
  },
  "Section tag": {
    "prefix": "b:section",
    "body": [
      "<b:section id=\"${1:main}\" maxwidgets=\"${2:1}\">",
      "\t$0",
      "</b:section>"
    ],
    "description": "Creates sections for widgets. It can only contain b:widget tags."
  },
  "Skin tag": {
    "prefix": "b:skin",
    "body": [
      "<b:skin>",
      "\t<![CDATA[",
      "\t\t$0",
      "\t]]>",
      "</b:skin>"
    ],
    "description": "Contains theme styles and variables intended for the Blogger Template Designer."
  },
  "Template skin tag": {
    "prefix": "b:template-skin",
    "body": [
      "<b:template-skin>",
      "\t<![CDATA[",
      "\t\t$0",
      "\t]]>",
      "</b:template-skin>"
    ],
    "description": "Contains theme styles intended for the Blogger layout Mode."
  },
  "Group tag": {
    "prefix": "Group",
    "body": [
      "<Group description=\"${1:Description}\" selector=\"${2:selector}\">",
      "\t$0",
      "</Group>"
    ],
    "description": "Groups variables and creates a section in the Blogger Template Designer."
  },
  "Variable tag": {
    "prefix": "Variable",
    "body": [
      "<Variable name=\"${1:name}\" description=\"${2:Description}\" type=\"${3:color}\" default=\"${4:default}\" value=\"${5:value}\"/>$0"
    ],
    "description": "Creates customization options for the Blogger Template Designer."
  },
  "Switch tag": {
    "prefix": "b:switch",
    "body": [
      "<b:switch var=\"${1:data:blog.pageType}\">",
      "\t<b:case value=\"${2:item}\"/>",
      "\t\t$0",
      "\t<b:default/>",
      "</b:switch>"
    ],
    "description": "Renders branches depending on evaluated switch expression."
  },
  "Case tag": {
    "prefix": "b:case",
    "body": [
      "<b:case value=\"${1:value}\"/>$0"
    ],
    "description": "Case branch of the previous switch evaluation."
  },
  "Default tag": {
    "prefix": "b:default",
    "body": [
      "<b:default/>$0"
    ],
    "description": "Default fallback case of the previous switch evaluation."
  },
  "Tag tag": {
    "prefix": "b:tag",
    "body": [
      "<b:tag name=\"${1:div}\">",
      "\t$0",
      "</b:tag>"
    ],
    "description": "Allows adding or creating any HTML tag dynamically."
  },
  "Widget tag": {
    "prefix": "b:widget",
    "body": [
      "<b:widget id=\"${1:Blog1}\" type=\"${2:Blog}\" title=\"${3:Blog Posts}\" locked=\"${4:false}\" version=\"2\">",
      "\t$0",
      "</b:widget>"
    ],
    "description": "Creates widgets that can only be contained by a b:section tag."
  },
  "Widget settings tag": {
    "prefix": "b:widget-settings",
    "body": [
      "<b:widget-settings>",
      "\t<b:widget-setting name=\"${1:name}\">",
      "\t\t$0",
      "\t</b:widget-setting>",
      "</b:widget-settings>"
    ],
    "description": "Allows configuring the settings container of a widget."
  },
  "Widget setting tag": {
    "prefix": "b:widget-setting",
    "body": [
      "<b:widget-setting name=\"${1:name}\">",
      "\t$0",
      "</b:widget-setting>"
    ],
    "description": "Configures a single setting item of a widget."
  },
  "Alias tag": {
    "prefix": "b:with",
    "body": [
      "<b:with value=\"${1:expression}\" var=\"${2:alias}\">",
      "\t$0",
      "</b:with>"
    ],
    "description": "Stores an expression in a scoped alias variable."
  }
}